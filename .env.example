# Copy this file to .env and fill in your friend's details.
# Lists use "|" between items.
# Avoid "$" in values (Vite treats it as a variable reference).

VITE_NAME="Ananya"
VITE_NICKNAME="Sunshine"
VITE_AGE=25
VITE_FROM="Dibyanshu"

# Accent colour for the whole site
VITE_ACCENT="#ff5e8a"

# Sound on by default? (true/false)
VITE_MUSIC=true

# Reason cards (tap through deck)
VITE_REASONS="You make ordinary days feel like a party|You're the first person I call with good news (and bad news)|Your laugh is dangerously contagious|You show up. Every single time.|You somehow make chaos look stylish"

# Words hidden inside balloons, revealed one pop at a time
VITE_BALLOON_WISH="May this year be your best one yet"

# Revealed on the scratch card
VITE_SECRET="Dinner's on me this weekend. Your pick. No budget talk. 🍕"

# The final letter. Use \n for new lines.
VITE_LETTER="Another year of you being you, and the world is better for it.\n\nThank you for every laugh, every late-night call, and every time you believed in me before I did.\n\nI hope this year gives back even a fraction of what you give everyone around you.\n\nHappy birthday. Go be ridiculous today."
